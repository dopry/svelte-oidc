{
	"name": "@dopry/svelte-oidc",
	"version": "0.0.0-semantic-release.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dopry/svelte-oidc.git"
	},
	"description": "Svelte OIDC Component Library",
	"keywords": [
		"svelte"
	],
	"license": "MIT",
	"main": "dist/index.min.js",
	"module": "dist/index.min.mjs",
	"exports": {
		".": {
			"import": "./dist/index.min.mjs",
			"require": "./dist/index.min.js",
			"svelte": "./src/lib/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"svelte": "src/lib/index.js",
	"scripts": {
		"build": "rollup -c",
		"lint": "eslint --color --ignore-path .gitignore .",
		"prepublishOnly": "npm run build",
		"showcase:publish": "gh-pages -d public",
		"showcase:build": "rollup -c rollup.config.showcase.js",
		"showcase:dev": "rollup -c rollup.config.showcase.js -w ",
		"start": "sirv public -s --port 5000",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui"
	},
	"browserslist": [
		"defaults"
	],
	"files": [
		"src",
		"dist"
	],
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"dependencies": {
		"oidc-client-ts": "^3.3.0"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@rollup/plugin-node-resolve": "11.2.1",
		"@rollup/plugin-replace": "2.4.2",
		"@semantic-release/github": "12.0.0",
		"@semantic-release/npm": "13.1.1",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"autoprefixer": "10.4.21",
		"eslint": "8.57.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte3": "4.0.0",
		"gh-pages": "6.3.0",
		"postcss": "8.5.6",
		"postcss-load-config": "3.1.4",
		"prettier": "3.6.2",
		"rollup": "2.79.2",
		"rollup-plugin-babel": "4.4.0",
		"rollup-plugin-commonjs": "10.1.0",
		"rollup-plugin-livereload": "2.0.5",
		"rollup-plugin-postcss": "4.0.2",
		"rollup-plugin-svelte": "7.2.3",
		"rollup-plugin-terser": "7.0.2",
		"semantic-release": "25.0.1",
		"sirv-cli": "3.0.1",
		"svelte": "3.59.2",
		"svelte-highlight": "7.9.0",
		"svelte-preprocess": "4.10.7",
		"typescript": "4.9.5"
	}
}